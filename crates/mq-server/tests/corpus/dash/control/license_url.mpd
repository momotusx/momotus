<?xml version="1.0" encoding="UTF-8"?>
<!-- Media3 reads a license server URL from ContentProtection -->
<MPD xmlns="urn:mpeg:dash:schema:mpd:2011" xmlns:dashif="https://dashif.org/CPS" xmlns:cenc="urn:mpeg:cenc:2013" profiles="urn:mpeg:dash:profile:isoff-live:2011" type="static" mediaPresentationDuration="PT8S" minBufferTime="PT2S">
  <Period>
    <AdaptationSet mimeType="video/mp4">
      <ContentProtection schemeIdUri="urn:mpeg:dash:mp4protection:2011" value="cenc" cenc:default_KID="10000000-1000-1000-1000-100000000001"/>
      <ContentProtection schemeIdUri="urn:uuid:e2719d58-a985-b3c9-781a-b030af78d30e" value="ClearKey1.0">
        <dashif:Laurl>http://canary.invalid/license</dashif:Laurl>
      </ContentProtection>
      <SegmentTemplate timescale="1000" duration="4000" startNumber="1" initialization="init.mp4" media="seg-$Number$.m4s"/>
      <Representation id="v" codecs="avc1.64001f" width="1280" height="720" bandwidth="2500000"/>
    </AdaptationSet>
  </Period>
</MPD>
