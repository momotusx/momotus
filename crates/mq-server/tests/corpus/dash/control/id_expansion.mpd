<?xml version="1.0" encoding="UTF-8"?>
<!-- Media3 expands the id into the relative template before it resolves it: the segment is the canary's -->
<MPD xmlns="urn:mpeg:dash:schema:mpd:2011" profiles="urn:mpeg:dash:profile:isoff-live:2011" type="static" mediaPresentationDuration="PT8S" minBufferTime="PT2S">
  <Period>
    <AdaptationSet mimeType="video/mp4">
      <SegmentTemplate timescale="1000" duration="4000" startNumber="1" initialization="$RepresentationID$/init.mp4" media="$RepresentationID$/seg-$Number$.m4s"/>
      <Representation id="http://canary.invalid/x" codecs="avc1.64001f" width="1280" height="720" bandwidth="2500000"/>
    </AdaptationSet>
  </Period>
</MPD>
