# third-party reference clones and closed artifacts: never committed
/ref/
# worker scratch
/.oc/
# build output
/target/
**/node_modules/
**/dist/
**/.gradle/
**/build/
**/DerivedData/
*.xcuserstate
.DS_Store
# local secrets
.env
*.local
/.playwright-mcp/
/.mq-data/
/apps/web/test-results/
/apps/web/playwright-report/
/apps/web/e2e/.cache/
/apps/android/core/src/main/jniLibs/
/apps/android/core/src/debug/jniLibs/
/apps/android/core/src/main/generated/
/apps/android/local.properties
/apps/android/.kotlin/

# A standalone build of a vendored crate (its own tests, the cast audit) writes its own lock file.
/vendor/*/Cargo.lock
