# Momotus's relay instance: deploy.sh reads it (bash) and renders the units from it. Another app's
# relay keeps a file like it in its own repository and passes its path to deploy.sh. Nothing secret
# goes here: an invite code goes in /etc/<NAME>/relay.env on the server (RELAY_FLAGS=--invite ...).
NAME=momotus
TITLE="Marquee sync relay"
HOST=momotus.normalisdead.mom
PORT=8787
PREFLIGHT_PORT=8789
# After --identity; %d is the unit's credentials folder. Error and crash reports
# (plans/error-reports.md 7, 8): their own database, 30 days, not backed up; the privacy page's
# Error reports section must be live before a relay with --reports is.
FLAGS="--mail %d/ses.json --reports /var/lib/momotus/reports.sqlite"
# Files in /etc/<NAME>/ the flags read, besides identity.json.
CREDENTIALS="ses.json"
