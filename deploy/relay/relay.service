# A sync relay instance (plans/accounts-social-sync.md section 3). deploy.sh renders it from an
# instance file (momotus.env) into /etc/systemd/system/@NAME@-relay.service: @NAME@, @TITLE@,
# @PORT@, @HOST@ and @FLAGS@ come from it, and @CREDENTIALS@ becomes one LoadCredential line per
# file it names. The identity file comes in through LoadCredential, never readable by the service
# user on disk.
[Unit]
Description=@TITLE@
After=network-online.target
Wants=network-online.target
# Ten quick failures in a minute stop the restarts; the journal says why.
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
User=@NAME@
Group=@NAME@
LoadCredential=identity.json:/etc/@NAME@/identity.json
# Further files the instance's flags read (Momotus: email sign-in's SES key, plans/accounts-email.md).
# systemd may refuse to start a unit whose credential file is missing.
@CREDENTIALS@
# Flags no repository may hold (an invite code), as RELAY_FLAGS=... in a root-only file, if any.
EnvironmentFile=-/etc/@NAME@/relay.env
ExecStart=/opt/@NAME@/bin/mq-sync-server --db /var/lib/@NAME@/relay.sqlite --listen 127.0.0.1:@PORT@ --trust-proxy --public-host @HOST@ --identity %d/identity.json @FLAGS@ $RELAY_FLAGS
Restart=always
RestartSec=2
# The relay's refusals (a bad identity file, a database of another schema) exit 2: no restart loop.
RestartPreventExitStatus=2
MemoryMax=256M
TasksMax=64
StateDirectory=@NAME@
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
# AF_NETLINK: mq-http's getifaddrs reads the machine's own addresses for its address guard.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
