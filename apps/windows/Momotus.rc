// The exe's icon, version info and manifest (build.rs). VERSION_TEXT and VERSION_COMMA come from the
// app version in apps/web/package.json through build.rs.
#pragma code_page(65001)

1 ICON "Momotus.ico"
1 24 "Momotus.manifest"

1 VERSIONINFO
FILEVERSION VERSION_COMMA
PRODUCTVERSION VERSION_COMMA
FILEOS 0x40004
FILETYPE 0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "Momotus"
      VALUE "ProductName", "Momotus"
      VALUE "FileVersion", VERSION_TEXT
      VALUE "ProductVersion", VERSION_TEXT
      VALUE "OriginalFilename", "Momotus.exe"
      VALUE "InternalName", "Momotus"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
