{
  "about": "Cases for the debrid storage helper every app builds (plans/c10-handoff.md section A1, plans/core-protocol.md Debrid). Each case starts a helper over a fake keystore holding `keystore`, runs `steps` in order and checks every `expect`. Ops: `pending` (a debrid view push), `disconnect` (started, not awaited; a failure lands in `errors`), `hold` (the next keystore call of that kind starts and waits for `release`), `release`, `fail` (the next `times` calls of that kind fail), `settle` (wait until every queue is idle), `restart` (a new helper over the same keystore runs its start). The keystore keeps one record per service; `deleteRecord` removes the service's record only when it has that generation. `log` lists finished keystore calls, `failed` ones included.",
  "cases": [
    {
      "name": "a queued record write is dropped when its tombstone arrives; the write in progress finishes first",
      "keystore": { "records": [], "tombstones": [] },
      "steps": [
        { "op": "hold", "call": "writeRecord" },
        { "op": "pending", "records": [{ "service": "torbox", "generation": "g1", "revision": 1, "credential": { "kind": "key", "key": "k1" } }] },
        { "op": "pending", "records": [{ "service": "torbox", "generation": "g1", "revision": 2, "credential": { "kind": "key", "key": "k2" } }] },
        { "op": "disconnect", "service": "torbox", "generation": "g1" },
        { "op": "release" },
        { "op": "settle" },
        {
          "op": "expect",
          "log": ["writeRecord g1 1", "writeTombstone g1", "deleteRecord g1", "deleteTombstone g1"],
          "records": [],
          "tombstones": [],
          "acks": ["torbox g1 1"],
          "disconnects": ["torbox g1"],
          "errors": []
        }
      ]
    },
    {
      "name": "a push for a generation already tombstoned is never written",
      "keystore": { "records": [{ "service": "torbox", "generation": "g1", "revision": 1, "credential": { "kind": "key", "key": "k1" } }], "tombstones": [] },
      "steps": [
        { "op": "hold", "call": "writeTombstone" },
        { "op": "disconnect", "service": "torbox", "generation": "g1" },
        { "op": "pending", "records": [{ "service": "torbox", "generation": "g1", "revision": 2, "credential": { "kind": "key", "key": "k2" } }] },
        { "op": "release" },
        { "op": "settle" },
        {
          "op": "expect",
          "log": ["writeTombstone g1", "deleteRecord g1", "deleteTombstone g1"],
          "records": [],
          "tombstones": [],
          "acks": [],
          "disconnects": ["torbox g1"],
          "errors": []
        }
      ]
    },
    {
      "name": "restart with a record and its tombstone finishes the disconnect",
      "keystore": {
        "records": [{ "service": "realdebrid", "generation": "g1", "revision": 3, "credential": { "kind": "key", "key": "k1" } }],
        "tombstones": [{ "service": "realdebrid", "generation": "g1" }]
      },
      "steps": [
        { "op": "restart" },
        { "op": "settle" },
        {
          "op": "expect",
          "log": ["deleteRecord g1", "deleteTombstone g1"],
          "records": [],
          "tombstones": [],
          "restores": [{ "records": [], "tombstones": [] }],
          "acks": [],
          "disconnects": [],
          "errors": []
        }
      ]
    },
    {
      "name": "a failed record write is not acknowledged and is written on the next push",
      "keystore": { "records": [], "tombstones": [] },
      "steps": [
        { "op": "fail", "call": "writeRecord", "times": 1 },
        { "op": "pending", "records": [{ "service": "alldebrid", "generation": "g1", "revision": 1, "credential": { "kind": "key", "key": "k1" } }] },
        { "op": "settle" },
        { "op": "expect", "log": ["writeRecord failed"], "records": [], "acks": [] },
        { "op": "pending", "records": [{ "service": "alldebrid", "generation": "g1", "revision": 1, "credential": { "kind": "key", "key": "k1" } }] },
        { "op": "settle" },
        {
          "op": "expect",
          "log": ["writeRecord failed", "writeRecord g1 1"],
          "records": ["alldebrid g1 1"],
          "acks": ["alldebrid g1 1"],
          "errors": []
        }
      ]
    },
    {
      "name": "a failed tombstone write stops the disconnect before the core is told",
      "keystore": { "records": [{ "service": "premiumize", "generation": "g1", "revision": 1, "credential": { "kind": "key", "key": "k1" } }], "tombstones": [] },
      "steps": [
        { "op": "fail", "call": "writeTombstone", "times": 1 },
        { "op": "disconnect", "service": "premiumize", "generation": "g1" },
        { "op": "settle" },
        {
          "op": "expect",
          "log": ["writeTombstone failed"],
          "records": ["premiumize g1 1"],
          "tombstones": [],
          "disconnects": [],
          "errors": ["premiumize g1"]
        }
      ]
    },
    {
      "name": "a failed record delete keeps the tombstone and is retried at start",
      "keystore": { "records": [{ "service": "torbox", "generation": "g1", "revision": 1, "credential": { "kind": "key", "key": "k1" } }], "tombstones": [] },
      "steps": [
        { "op": "fail", "call": "deleteRecord", "times": 1 },
        { "op": "disconnect", "service": "torbox", "generation": "g1" },
        { "op": "settle" },
        {
          "op": "expect",
          "log": ["writeTombstone g1", "deleteRecord failed"],
          "records": ["torbox g1 1"],
          "tombstones": ["torbox g1"],
          "disconnects": ["torbox g1"],
          "errors": []
        },
        { "op": "restart" },
        { "op": "settle" },
        {
          "op": "expect",
          "log": ["writeTombstone g1", "deleteRecord failed", "deleteRecord g1", "deleteTombstone g1"],
          "records": [],
          "tombstones": [],
          "restores": [{ "records": [], "tombstones": [] }]
        }
      ]
    },
    {
      "name": "a tombstone stays while its record is still stored; restore gets both",
      "keystore": {
        "records": [{ "service": "torbox", "generation": "g1", "revision": 1, "credential": { "kind": "key", "key": "k1" } }],
        "tombstones": [{ "service": "torbox", "generation": "g1" }]
      },
      "steps": [
        { "op": "fail", "call": "deleteRecord", "times": 1 },
        { "op": "restart" },
        { "op": "settle" },
        {
          "op": "expect",
          "log": ["deleteRecord failed"],
          "records": ["torbox g1 1"],
          "tombstones": ["torbox g1"],
          "restores": [{ "records": ["torbox g1 1"], "tombstones": ["torbox g1"] }]
        }
      ]
    },
    {
      "name": "a record is never written over the same generation with a higher revision",
      "keystore": { "records": [{ "service": "realdebrid", "generation": "g1", "revision": 3, "credential": { "kind": "key", "key": "k3" } }], "tombstones": [] },
      "steps": [
        { "op": "pending", "records": [{ "service": "realdebrid", "generation": "g1", "revision": 2, "credential": { "kind": "key", "key": "k2" } }] },
        { "op": "settle" },
        { "op": "expect", "log": [], "records": ["realdebrid g1 3"], "acks": ["realdebrid g1 2"] }
      ]
    },
    {
      "name": "a new generation replaces the service's record, and disconnecting the old one leaves it",
      "keystore": { "records": [{ "service": "torbox", "generation": "g1", "revision": 1, "credential": { "kind": "key", "key": "k1" } }], "tombstones": [] },
      "steps": [
        { "op": "pending", "records": [{ "service": "torbox", "generation": "g2", "revision": 1, "credential": { "kind": "key", "key": "k2" } }] },
        { "op": "disconnect", "service": "torbox", "generation": "g1" },
        { "op": "settle" },
        {
          "op": "expect",
          "log": ["writeRecord g2 1", "writeTombstone g1", "deleteRecord g1", "deleteTombstone g1"],
          "records": ["torbox g2 1"],
          "tombstones": [],
          "acks": ["torbox g2 1"],
          "disconnects": ["torbox g1"]
        }
      ]
    }
  ]
}
