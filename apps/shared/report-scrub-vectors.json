{
  "about": "Scrubber vectors for error reports (plans/error-reports.md section 4): each case is a free-text line a report may carry (`in`) and what `mq_reports::scrub` must make of it (`out`). Cases whose `out` equals `in` are lines that must survive: frames, numbers, dates and ordinary English. `rule` names the rule a case pins. The core's uploader and the relay both run the scrubber; crates/mq-reports reads this file in its tests.",
  "cases": [
    { "rule": "1 url", "in": "addon request failed: https://torrentio.strem.fun/realdebrid=ABCDEF1234567890ABCD/manifest.json timed out", "out": "addon request failed: <url> timed out" },
    { "rule": "1 url without scheme", "in": "fetch torrentio.strem.fun/realdebrid=ABCDEF1234567890ABCD/manifest.json failed", "out": "fetch <url> failed" },
    { "rule": "1 url without scheme, port", "in": "sync.example.com:8787/v1/push failed", "out": "<url> failed" },
    { "rule": "1 redact_url output keeps a title id", "in": "GET https://v3-cinemeta.strem.io/meta/movie/tt0111161.json failed", "out": "GET <url> failed" },
    { "rule": "1 file url", "in": "Cannot Open file:///var/mobile/Containers/Data/Application/1B2C/x.mp4", "out": "Cannot Open <url>" },
    { "rule": "1 magnet", "in": "bad magnet:?xt=urn:btih:abc&dn=Movie", "out": "bad <magnet>" },
    { "rule": "2 authorization", "in": "Authorization: Bearer abc.def.ghi", "out": "Authorization: <secret>" },
    { "rule": "2 bearer", "in": "bearer eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiIxIn0.sig refused", "out": "bearer <secret> refused" },
    { "rule": "2 key=value", "in": "refused api_key=ZXCVBNM123 status=401", "out": "refused api_key=<secret> status=401" },
    { "rule": "3 json input", "in": "JSON input: {\"token\":\"abc123\",\"user\":\"x\"}", "out": "JSON input: {<text>:<text>,<text>:<text>}" },
    { "rule": "3 short quoted title", "in": "no row for \"Dune\"", "out": "no row for <text>" },
    { "rule": "3 typographic quotes", "in": "search “dune 2” gave nothing", "out": "search <text> gave nothing" },
    { "rule": "3 single quotes and apostrophes", "in": "can't open 'Dune Part Two', it doesn't exist", "out": "can't open <text>, it doesn't exist" },
    { "rule": "3 apostrophes only", "in": "can't open, it doesn't exist", "out": "can't open, it doesn't exist" },
    { "rule": "4 path with spaces", "in": "cannot open /Users/robin/Movies/The Matrix (1999)/The Matrix (1999) 1080p BluRay.mkv", "out": "cannot open <path>" },
    { "rule": "4 android storage path", "in": "open failed: /storage/emulated/0/Download/x.mkv: ENOENT", "out": "open failed: <path>" },
    { "rule": "4 android app path", "in": "/data/user/0/app.momotus.android/files/db.sqlite is locked", "out": "<path>" },
    { "rule": "4 windows path", "in": "D:\\Users\\robin\\x.txt not found", "out": "<path>" },
    { "rule": "4 mac container path", "in": "/Users/robin/Library/Containers/app.momotus.dev/Data/tmp", "out": "<path>" },
    { "rule": "4 linux home", "in": "/home/robin/.config/x", "out": "<path>" },
    { "rule": "4 tilde path", "in": "wrote ~/Library/Caches/x", "out": "wrote <path>" },
    { "rule": "4 a ratio is not a path", "in": "read 0/5 bytes", "out": "read 0/5 bytes" },
    { "rule": "5 email", "in": "sent to robin@example.com", "out": "sent to <email>" },
    { "rule": "5 ipv4", "in": "connect 192.0.2.105:5555 refused", "out": "connect <ip>:5555 refused" },
    { "rule": "5 ipv6", "in": "peer 2a01:4f8:10a:1::2 dropped", "out": "peer <ip> dropped" },
    { "rule": "5 a rust path is not ipv6", "in": "h2::proto::streams error", "out": "h2::proto::streams error" },
    { "rule": "5 a time is not ipv6", "in": "at 12:30:45 stalled", "out": "at 12:30:45 stalled" },
    { "rule": "5 mac", "in": "mac aa:bb:cc:dd:ee:ff", "out": "mac <mac>" },
    { "rule": "5 local host", "in": "resolve tv.local failed", "out": "resolve <host> failed" },
    { "rule": "6 imdb id", "in": "no meta for tt0111161", "out": "no meta for <title>" },
    { "rule": "6 prefixed id", "in": "kitsu:12345 not found", "out": "<title> not found" },
    { "rule": "7 dotted release", "in": "no stream in Movie.Name.2019.1080p.WEB-DL.x265", "out": "no stream in <file>" },
    { "rule": "7 bracket year", "in": "no row for The Matrix (1999)", "out": "<file>" },
    { "rule": "7 media file", "in": "subtitle Dune.Part.Two.srt unreadable", "out": "subtitle <file> unreadable" },
    { "rule": "7 residual: an unquoted title with no year is kept", "in": "IllegalStateException: no row for The Matrix", "out": "IllegalStateException: no row for The Matrix" },
    { "rule": "7 a buffer size is not a year", "in": "index out of bounds: the len is 2048 but the index is 2050", "out": "index out of bounds: the len is 2048 but the index is 2050" },
    { "rule": "7 a duration is not a year", "in": "read stalled 2000 ms", "out": "read stalled 2000 ms" },
    { "rule": "7 an iso date is not a release", "in": "cache from 2026-11-08 expired", "out": "cache from 2026-11-08 expired" },
    { "rule": "8 info hash", "in": "torrent 0123456789abcdef0123456789abcdef01234567 stalled", "out": "torrent <hash> stalled" },
    { "rule": "8 jwt", "in": "token eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiIxIn0.c2ln expired", "out": "token <token> expired" },
    { "rule": "8 long key", "in": "debrid key ABCDEFGHIJKLMNOPQRSTUVWXYZ234567ABCDEFGHIJKLMNOPQRST refused", "out": "debrid key <token> refused" },
    { "rule": "8 key at the floor", "in": "key a1b2c3d4e5f6g7h8", "out": "key <token>" },
    { "rule": "8 uuid", "in": "torbox 123e4567-e89b-12d3-a456-426614174000 refused", "out": "torbox <uuid> refused" },
    { "rule": "frame: kotlin with a year-like line", "in": "app.marquee.player.PlaybackController.failed(PlaybackController.kt:2024)", "out": "app.marquee.player.PlaybackController.failed(PlaybackController.kt:2024)" },
    { "rule": "frame: obfuscated kotlin", "in": "a.b.c(SourceFile:12)", "out": "a.b.c(SourceFile:12)" },
    { "rule": "frame: android anr line", "in": "at android.os.MessageQueue.nativePollOnce(Native Method)", "out": "at android.os.MessageQueue.nativePollOnce(Native Method)" },
    { "rule": "frame: swift", "in": "Momotus 0x1a2b3c", "out": "Momotus 0x1a2b3c" },
    { "rule": "frame: js asset", "in": "client-B3xQ9kLm.js:1:2345", "out": "client-B3xQ9kLm.js:1:2345" },
    { "rule": "rust panic text", "in": "called `Option::unwrap()` on a `None` value", "out": "called `Option::unwrap()` on a `None` value" }
  ]
}
