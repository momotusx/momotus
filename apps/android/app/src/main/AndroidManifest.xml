<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Scanning a new device's pairing code (Add a device); asked for only when the user taps Scan. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- The screen-lock prompt before a sync account's devices change (approve, remove, report lost, They differ, the server's list), a recovery kit is made, or this device stops syncing. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- PlayerWindow sets picture in picture's auto-enter on Android 12 and later; lint cannot see it. -->
    <application
        android:name=".MarqueeApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        tools:ignore="PictureInPictureIssue"
        android:banner="@drawable/banner"
        android:icon="@drawable/ic_launcher"
        android:label="Marquee"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Marquee"
        tools:replace="android:networkSecurityConfig">

        <!-- Macrobenchmark and baseline profiles read a release build's traces from the shell. -->
        <profileable android:shell="true" tools:targetApi="29" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:supportsPictureInPicture="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|uiMode|density|keyboard|keyboardHidden|navigation|layoutDirection">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Empties the clipboard a minute after a recovery kit was copied, even when the app was ended meanwhile. -->
        <receiver
            android:name=".KitClipReceiver"
            android:exported="false" />
    </application>
</manifest>
